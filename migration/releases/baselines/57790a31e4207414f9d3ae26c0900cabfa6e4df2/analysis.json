3ccafad119747d41f47893ff3dfda283a5300c9881685a","raw_tab_starts":3,"active_tab_starts":3,"raw_fences":13,"active_fences":13,"source_h1":["# Troubleshooting"],"adjacent_note_counterfactuals":[],"legacy_code_blocks":13,"legacy_tab_groups":3,"legacy_h1":[{"level":1,"id":"troubleshooting","text":"Troubleshooting¶"}]},"docs/virtuozzo-cs-correspondence.md":{"source_sha256":"6095cbc374f8ba285100c0e4a7a6e0ce56a3c30fd46b04492059354866d5f28b","raw_tab_starts":0,"active_tab_starts":0,"raw_fences":0,"active_fences":0,"source_h1":[],"adjacent_note_counterfactuals":[],"legacy_code_blocks":0,"legacy_tab_groups":0,"legacy_h1":[{"level":1,"id":"virtuozzo-cs-correspondence","text":"Virtuozzo Application Platform & CS Correspondence"}]}},"correspondence_templates":[{"source_path":"theme/readthedocs/virtuozzo-cs-correspondence.html","sha256":"064581ed50f9a811b86627a56cab9537e50ab5802484fec1fc322d505210852e","text":"<h1 id=\"virtuozzo-cs-correspondence\">Virtuozzo Application Platform & CS Correspondence</h1>\n\nThe table below displays dependencies between Cloud Scripting and the Virtuozzo Application Platform versions within the same <a href=\"https://www.virtuozzo.com/application-platform-partners/\" target=\"_blank\">hosting provider</a> platform.\n\n{% if config.extra.all_versions %}\n    {% if config.extra.all_virt_versions %}\n\n        <table class=\"corresp\" style=\"width:100%\">\n            <tr id=\"cs\">\n                <th id=\"table-head\">CS</th>\n                    {% for version in config.extra.all_versions %}\n                        <td>{{ version }}</td>\n                    {% endfor %}\n            </tr>\n            <tr id=\"jel\">\n                <th id=\"table-head\">Virtuozzo PaaS</th>\n                {% for version in config.extra.all_virt_versions %}\n                    <td>{{ version }}</td>\n                {% endfor %}\n            </tr>\n        </table>\n\n    {% endif %}\n{% endif %}","h1":["<h1 id=\"virtuozzo-cs-correspondence\">Virtuozzo Application Platform & CS Correspondence</h1>"],"intro":"<h1 id=\"virtuozzo-cs-correspondence\">Virtuozzo Application Platform & CS Correspondence</h1>\n\nThe table below displays dependencies between Cloud Scripting and the Virtuozzo Application Platform versions within the same <a href=\"https://www.virtuozzo.com/application-platform-partners/\" target=\"_blank\">hosting provider</a> platform.\n\n"}]}
