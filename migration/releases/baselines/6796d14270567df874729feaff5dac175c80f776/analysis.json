d":{"source_sha256":"c6549f96d2453d368286c99d2403cbad9476ac1c5e20721a2dbba008ec015299","raw_tab_starts":0,"active_tab_starts":0,"raw_fences":0,"active_fences":0,"source_h1":["# Samples"],"adjacent_note_counterfactuals":[],"legacy_code_blocks":0,"legacy_tab_groups":0,"legacy_h1":[{"level":1,"id":"samples","text":"Samples¶"}]},"docs/troubleshooting.md":{"source_sha256":"1714b58073c525a8efd07edda400a00d4cb6df2b237dd10377c0c932405ab399","raw_tab_starts":3,"active_tab_starts":3,"raw_fences":13,"active_fences":13,"source_h1":["# Troubleshooting"],"adjacent_note_counterfactuals":[],"legacy_code_blocks":13,"legacy_tab_groups":3,"legacy_h1":[{"level":1,"id":"troubleshooting","text":"Troubleshooting¶"}]}},"correspondence_templates":[{"source_path":"theme/readthedocs/jelastic-cs-correspondence.html","sha256":"6137f5f71614614134ef981389a9ba351cd1fa5cdb4ef1d143a5434d543cfbb1","text":"<h1 id=\"jelastic-cs-correspondence\">Jelastic & CS Correspondence</h1>\n\nThe table below displays dependencies between Cloud Scripting and the Jelastic Platform versions within the same <a href=\"https://jelastic.cloud/\" target=\"_blank\">hosting provider</a> platform.\n\n{% if config.extra.all_versions %}\n    {% if config.extra.all_jel_versions %}\n\n        <table class=\"corresp\" style=\"width:100%\">\n            <tr id=\"cs\">\n                <th id=\"table-head\">CS</th>\n                    {% for version in config.extra.all_versions %}\n                        <td>{{ version }}</td>\n                    {% endfor %}\n            </tr>\n            <tr id=\"jel\">\n                <th id=\"table-head\">Jelastic</th>\n                {% for version in config.extra.all_jel_versions %}\n                    <td>{{ version }}</td>\n                {% endfor %}\n            </tr>\n        </table>\n\n    {% endif %}\n{% endif %}","h1":["<h1 id=\"jelastic-cs-correspondence\">Jelastic & CS Correspondence</h1>"],"intro":"<h1 id=\"jelastic-cs-correspondence\">Jelastic & CS Correspondence</h1>\n\nThe table below displays dependencies between Cloud Scripting and the Jelastic Platform versions within the same <a href=\"https://jelastic.cloud/\" target=\"_blank\">hosting provider</a> platform.\n\n"}]}
