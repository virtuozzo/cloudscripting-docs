{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Immutable Cloud Scripting Hugo artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "base_url", "manifest_sha256", "content_commit", "tooling_commit", "theme_commit", "tools", "prefixes", "builds"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"enum": ["production", "preview"]},
    "base_url": {"type": "string", "pattern": "^https?://[^/?#]+(?:/[^?#]*)?/$"},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "content_commit": {"$ref": "#/$defs/commit"},
    "tooling_commit": {"$ref": "#/$defs/commit"},
    "theme_commit": {"const": "91b3863e863981905ba45566832022270a56085f"},
    "tools": {"const": {"hugo": "0.124.1", "hugo_extended": true, "task": "3.44.1"}},
    "prefixes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/prefix"}},
    "builds": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "output_prefix", "source_commit", "source_format", "validation_source_commit", "site_report"],
        "properties": {
          "id": {"type": "string", "pattern": "^(?:root|[0-9]+(?:\\.[0-9]+)+(?:-[0-9]+)?)$"},
          "output_prefix": {"$ref": "#/$defs/prefix"},
          "source_commit": {"$ref": "#/$defs/commit"},
          "source_format": {"enum": ["mkdocs", "hugo"]},
          "validation_source_commit": {"$ref": "#/$defs/commit"},
          "site_report": {"type": "string", "pattern": "^validation/(?:root|[0-9]+(?:\\.[0-9]+)+(?:-[0-9]+)?)\\.json$"}
        }
      }
    }
  },
  "$defs": {
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "prefix": {"type": "string", "pattern": "^(?:[0-9]+(?:\\.[0-9]+)+(?:-[0-9]+)?/)?$"}
  }
}
